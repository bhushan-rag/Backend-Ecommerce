# Copy to .env for local development and set the same variables in your hosting provider (e.g. Render)
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/e-commerce
JWT_SECRET=change-me
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma separated list of frontend/admin URLs allowed to call this API
ALLOWED_ORIGINS=https://ecommerce-bhushan.vercel.app,https://admin-bhushan.vercel.app,http://localhost:3000,http://localhost:3001
